# RepoXray public Supabase configuration
# Copy this file to .env and replace both placeholder values.
# These values are safe to expose to the Vite client; do NOT put server secrets here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-or-publishable-key

# Server-side secrets are configured in Supabase Edge Function secrets, not in .env:
#   LOVABLE_API_KEY=your-ai-gateway-key
# Optional, but recommended to avoid GitHub API rate limits:
#   GITHUB_TOKEN=your-github-token
